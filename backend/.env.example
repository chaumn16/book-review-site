# Get a key from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Optional locally: defaults to a local SQLite file if unset.
# Required in production: a Postgres connection string, e.g. from Neon/Supabase/Render.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Optional: comma-separated list of allowed frontend origins for CORS.
# Defaults to "*" (any origin) if unset -- fine for local dev, set this
# explicitly in production.
# FRONTEND_ORIGINS=https://your-frontend.vercel.app
